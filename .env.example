# Copiez ce fichier en .env et remplissez avec les valeurs de votre projet Supabase
# Dashboard Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre_publishable_key

# Pour le script d'import CSV (scripts/import-draws-to-supabase.mjs)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# Lottery Results API (calendrier, dernier tirage, mise à jour auto)
# Créez un token sur https://www.lotteryresultsapi.com (section Legacy/Alpha ou v1)
VITE_LOTTERY_API_KEY=
# Optionnel : URL alpha si vous utilisez la version legacy
# VITE_LOTTERY_API_URL=https://alpha-api.lotteryresultsapi.com

# Admin (email pour l'import CSV admin)
VITE_ADMIN_EMAIL=
